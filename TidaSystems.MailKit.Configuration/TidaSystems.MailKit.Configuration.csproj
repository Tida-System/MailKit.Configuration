<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>TidaSystems.MailKit.Configuration</PackageId>
		<Version>0.1.0</Version>
		<Title>TidaSystems MailKit Configuration</Title>
		<Authors>TidaSystems</Authors>
		<Company>TidaSystems</Company>
		<Description>Configure MailKit SMTP directly from appsettings.json using native MailKit property names. Supports configuration validation, automatic reload and Native AOT compatibility.</Description>
		<PackageTags>MailKit;SMTP;Email;Configuration;appsettings;NativeAOT;TLS;OAuth2</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="MailKit" Version="5.0.0" />
	</ItemGroup>

</Project>
