<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<Authors>TidaSystems</Authors>
		<PackageProjectUrl>https://tida.website</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TidaSystems/MailKit.Configuration</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>TidaSystems.MailKit.Configuration</PackageId>
		<Version>1.0.0</Version>
		<Title>TidaSystems MailKit Configuration</Title>
		<Authors>TidaSystems</Authors>
		<Company>TidaSystems</Company>
		<Description>Configure MailKit SMTP directly from appsettings.json using native MailKit property names. Supports configuration validation, automatic reload and Native AOT compatibility.</Description>
		<PackageTags>MailKit;SMTP;Email;Configuration;appsettings;NativeAOT;TLS;OAuth2</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="MailKit" Version="5.0.0" />
	</ItemGroup>

</Project>
